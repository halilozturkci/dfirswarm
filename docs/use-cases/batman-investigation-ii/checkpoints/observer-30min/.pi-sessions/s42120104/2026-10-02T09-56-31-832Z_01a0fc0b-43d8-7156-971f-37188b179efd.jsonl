0130/out/archive/contact/instance1/hostkeys','store/jobs/j000130/out/archive/contact/instance_db/hostkeys']\nkeys={'raw':pw,'md5':hashlib.md5(pw).digest(),'sha1':hashlib.sha1(pw).digest(),'sha256':hashlib.sha256(pw).digest(),'sha512a':hashlib.sha512(pw).digest()[:32],'sha512b':hashlib.sha512(pw).digest()[32:],'sha256x2':hashlib.sha256(hashlib.sha256(pw).digest()).digest()}\nfor alg in ('sha1','sha256','sha512'):\n for salt in (b'',b'dropbox',b'Dropbox',b'hostkeys',b'HOSTKEYS'):\n  for n in (1,1000,10000,65536,100000):keys[f'pbkdf2-{alg}-{salt!r}-{n}']=hashlib.pbkdf2_hmac(alg,pw,salt,n,32)\nres=[]; pads=[]\nfor fp in files:\n b=open(fp,'rb').read(); label=os.path.basename(os.path.dirname(fp))\n for kn,k in keys.items():\n  if len(k) in (16,24,32):\n   # CBC layouts\n   for ln,iv,ct in [('v-iv16-ct64',b[1:17],b[17:]),('v-ct80-ivzero',b'\\0'*16,b[1:]),('iv16-ct64-vlast',b[:16],b[16:80])]:\n    if len(ct)%16:continue\n    pt=AES.new(k,AES.MODE_CBC,iv).decrypt(ct); n=pt[-1]\n    if 1<=n<=16 and pt[-n:]==bytes([n])*n:pads.append([label,kn,ln,n,pt[:-n].hex()])\n  # AEAD possible nonce 12/16 and tag at end sizes 16/12\n  if len(k) in (16,24,32):\n   for skip in (0,1):\n    for nl in (12,16):\n     for tl in (16,12):\n      if skip+nl+tl>=len(b):continue\n      nonce=b[skip:skip+nl];ct=b[skip+nl:-tl];tag=b[-tl:]\n      for aadn,aad in [('none',b''),('ver',b[:1]),('prefix',b[:skip]),('nonce',nonce)]:\n       try:\n        c=AES.new(k,AES.MODE_GCM,nonce=nonce,mac_len=tl);c.update(aad);pt=c.decrypt_and_verify(ct,tag);res.append([label,kn,'AESGCM',skip,nl,tl,aadn,pt.hex()])\n       except:pass\n  if len(k)==32:\n   for skip in (0,1):\n    for nl in (8,12,24):\n     if skip+nl+16>=len(b):continue\n     nonce=b[skip:skip+nl];ct=b[skip+nl:-16];tag=b[-16:]\n     for aadn,aad in [('none',b''),('ver',b[:1]),('prefix',b[:skip]),('nonce',nonce)]:\n      try:c=ChaCha20_Poly1305.new(key=k,nonce=nonce);c.update(aad);pt=c.decrypt_and_verify(ct,tag);res.append([label,kn,'ChaChaPoly',skip,nl,16,aadn,pt.hex()])\n      except:pass\nprint('authenticated',res);print('valid padding',len(pads));print(*pads[:20],sep='\\n')\nopen(os.environ['OUT']+'/hostkeys-crypto-tests.json','w').write(json.dumps({'authenticated':res,'valid_pkcs7':pads,'key_names':list(keys)},indent=2))\nPY","inputs":["job:j000107/entries.json","job:j000130/archive/contact/instance1/hostkeys","job:j000130/archive/contact/instance_db/hostkeys"],"timeout_seconds":120,"wait_seconds":100,"lead":"L-3","secret_output":true}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-daybreak-blue-latest","usage":{"input":2515,"output":1372,"cacheRead":97536,"cacheWrite":0,"reasoning":329,"totalTokens":101423,"cost":{"input":0.012575000000000001,"output":0.04116,"cacheRead":0.048768,"cacheWrite":0,"total":0.10250300000000001}},"stopReason":"toolUse","timestamp":1790936500985,"responseId":"resp_069ccbfd3ec00a4f016abf85b5645c87d2a48cf7cf344643e2","rawStopReason":"completed"}}
