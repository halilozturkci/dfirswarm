{"type":"message","id":"31ee7b68","parentId":"eb7834c5","timestamp":"2026-10-02T10:08:43.928Z","message":{"role":"toolResult","toolCallId":"call_3lsWs40BabjQcbALJQRWBy8p|fc_069ccbfd3ec00a4f016abf82a98f0887d29d3b2a2d8fb85ee0","toolName":"bash","content":[{"type":"text","text":"/opt/dfir/venv/lib/python3.11/site-packages/dissect/target/plugins/apps/ssh/putty.py\n/opt/dfir/venv/lib/python3.11/site-packages/jedi/third_party/typeshed/stubs/paramiko/paramiko/__init__.pyi\n/opt/dfir/venv/lib/python3.11/site-packages/jedi/third_party/typeshed/stubs/paramiko/paramiko/client.pyi\n/opt/dfir/venv/lib/python3.11/site-packages/jedi/third_party/typeshed/stubs/paramiko/paramiko/hostkeys.pyi\n/opt/dfir/venv/lib/python3.11/site-packages/jedi/third_party/typeshed/stubs/paramiko/paramiko/util.pyi\n/opt/dfir/venv/lib/python3.11/site-packages/jedi/third_party/typeshed/stubs/pysftp/pysftp/__init__.pyi\n/opt/dfir/venv/lib/python3.11/site-packages/jedi-0.20.0.dist-info/RECORD\n/opt/dfir/venv/lib/python3.11/site-packages/regipy/plugins/ntuser/putty.py\n/opt/dfir/venv/lib64/python3.11/site-packages/dissect/target/plugins/apps/ssh/putty.py\n/opt/dfir/venv/lib64/python3.11/site-packages/jedi/third_party/typeshed/stubs/paramiko/paramiko/__init__.pyi\n/opt/dfir/venv/lib64/python3.11/site-packages/jedi/third_party/typeshed/stubs/paramiko/paramiko/client.pyi\n/opt/dfir/venv/lib64/python3.11/site-packages/jedi/third_party/typeshed/stubs/paramiko/paramiko/hostkeys.pyi\n/opt/dfir/venv/lib64/python3.11/site-packages/jedi/third_party/typeshed/stubs/paramiko/paramiko/util.pyi\n/opt/dfir/venv/lib64/python3.11/site-packages/jedi/third_party/typeshed/stubs/pysftp/pysftp/__init__.pyi\n/opt/dfir/venv/lib64/python3.11/site-packages/jedi-0.20.0.dist-info/RECORD\n/opt/dfir/venv/lib64/python3.11/site-packages/regipy/plugins/ntuser/putty.py\n"}],"isError":false,"timestamp":1790935723927}}
