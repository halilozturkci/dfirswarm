3) or (o==64 and v<=1) or (o not in (44,56,64) and v<=maxv):s+=w;why.append([o,v])\n z=sum(x==0 for x in h[72-24:92-24]);s+=z\n ver=vals[96]\n if 2000000<=ver<=5000000:s+=8;why.append([96,ver])\n return s,why,vals\nouts=[]\nfor lab,hp,dp in pairs:\n h=open(hp,'rb').read();p=open(dp,'rb').read()[:4096]\n keys={}\n for off in range(len(h)):\n  for n in (16,24,32):\n   if off+n<=len(h):keys[f's{off}:{n}']=h[off:off+n]\n for kn,k in list(keys.items()):\n  keys[kn+'h']=hashlib.sha256(k).digest()\n for kn,k in keys.items():\n  # stream source starts at s, decrypt enough to cover 24:100\n  for start in (0,16,24):\n   skip=24-start;n=100-start;ct=p[start:n]\n   ivs={'dbfirst':p[:16],'dblasts':p[-12:]+b'\\0'*4,'dblastsfront':b'\\0'*4+p[-12:],'hostlast':h[-16:],'zero':bytes(16)}\n   for ivn,iv in ivs.items():\n    modes=[]\n    try:modes.append(('ctr',AES.new(k,AES.MODE_CTR,nonce=b'',initial_value=int.from_bytes(iv,'big')).decrypt(ct)))\n    except:pass\n    try:modes.append(('ctrle',AES.new(k,AES.MODE_CTR,nonce=b'',initial_value=int.from_bytes(iv,'little')).decrypt(ct)))\n    except:pass\n    if len(ct)%16==0:\n     for mn,mode in [('cbc',AES.MODE_CBC),('ofb',AES.MODE_OFB),('cfb128',AES.MODE_CFB)]:\n      try:\n       c=AES.new(k,mode,iv,segment_size=128) if mode==AES.MODE_CFB else AES.new(k,mode,iv);modes.append((mn,c.decrypt(ct)))\n      except:pass\n    for mn,pt in modes:\n     hdr=pt[skip:skip+76];sc,why,vals=score(hdr);outs.append([sc,lab,kn,start,ivn,mn,hdr.hex(),why])\nouts.sort(reverse=True)\nprint('top');\nfor x in outs[:30]:print(x[:6],x[7])\nopen(os.environ['OUT']+'/sqlite-header-structure-tests.json','w').write(json.dumps({'top':outs[:200]},indent=2))\nPY\npython3 /tmp/y.py","inputs":["job:j000130/archive/contact/instance1/hostkeys","job:j000130/archive/contact/instance1/config.dbx","job:j000130/archive/contact/instance_db/hostkeys","job:j000130/archive/contact/instance_db/instance.dbx"],"timeout_seconds":120,"wait_seconds":100,"lead":"L-3","secret_output":true}