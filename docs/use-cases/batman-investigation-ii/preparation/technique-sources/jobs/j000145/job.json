    "command": "set -euo pipefail\nTMP=$(mktemp -d /tmp/official7zz.XXXXXX)\ncp store/imports/mat-0001/out/7zz \"$TMP/7zz\"\nchmod 700 \"$TMP/7zz\"\nmkdir -p \"$OUT/selftest/src\" \"$OUT/selftest/extracted\"\nprintf 'DFIR offline known-answer self-test\\n' > \"$OUT/selftest/src/known.txt\"\n\"$TMP/7zz\" a -bd -y \"$OUT/selftest/known.7z\" \"$OUT/selftest/src/known.txt\" > \"$OUT/selftest/create.txt\"\n\"$TMP/7zz\" t -bd \"$OUT/selftest/known.7z\" > \"$OUT/selftest/test.txt\"\n\"$TMP/7zz\" x -bd -y \"$OUT/selftest/known.7z\" -o\"$OUT/selftest/extracted\" > \"$OUT/selftest/extract.txt\"\ncmp \"$OUT/selftest/src/known.txt\" \"$OUT/selftest/extracted/known.txt\"\nprintf 'selftest_sha256=' > \"$OUT/selftest/result.txt\"; sha256sum \"$OUT/selftest/extracted/known.txt\" | awk '{print $1}' >> \"$OUT/selftest/result.txt\"\n\"$TMP/7zz\" t -bd -slt store/jobs/j000067/out/contact.rar > \"$OUT/contact-test-slt.txt\"\nmkdir -p \"$OUT/contact\"\n\"$TMP/7zz\" x -bd -y store/jobs/j000067/out/contact.rar -o\"$OUT/contact\" > \"$OUT/contact-extract.txt\"\nfind \"$OUT/contact\" -type f -printf '%P\\t%s\\n' | sort > \"$OUT/contact-files.tsv\"\nfind \"$OUT/contact\" -type f -print0 | sort -z | xargs -0 sha256sum > \"$OUT/contact-sha256.txt\"\n\"$TMP/7zz\" i > \"$OUT/7zz-info.txt\"\ncat \"$OUT/selftest/result.txt\"; tail -20 \"$OUT/contact-test-slt.txt\"; wc -l \"$OUT/contact-files.tsv\""
