    "command": "python3 - <<'PY'\nimport os,json,hashlib\npaths=[\n'inputs/chall/Carmine-Falcone.raw','inputs/chall/unknown.data',\n'store/jobs/j000145/out/contact/contact/info.json',\n'store/jobs/j000145/out/contact/contact/instance1/config.dbx',\n'store/jobs/j000145/out/contact/contact/instance1/contacts_polaris.db',\n'store/jobs/j000145/out/contact/contact/instance1/photo.dbx',\n'store/jobs/j000145/out/contact/contact/instance1/hostkeys',\n'store/jobs/j000145/out/contact/contact/instance_db/instance.dbx',\n'store/jobs/j000145/out/contact/contact/instance_db/hostkeys',\n'store/jobs/j000194/out/plaintext-sqlite-search.json',\n'store/jobs/j000239/out/provider-email-contexts.json',\n'store/jobs/j000241/out/create-table-contexts.json',\n'store/jobs/j000242/out/targeted-ctr-validation.json',\n'store/jobs/j000249/out/metrics-field-audit.json',\n'store/jobs/j000256/out/nucleus/all-rows.json',\n'store/jobs/j000256/out/apex/all-rows.json',\n'store/jobs/j000260/out/nucleus-hostkeys-auth.json']\nr=[]\nfor p in paths:\n st=os.stat(p); ent={'path':p,'size':st.st_size}\n with open(p,'rb') as f:\n  if st.st_size<=20_000_000:\n   b=f.read(); ent['sha256']=hashlib.sha256(b).hexdigest(); ent['read_bytes']=len(b)\n   if p.endswith('.json'):\n    json.loads(b);ent['json_valid']=True\n  else:\n   first=f.read(4096);f.seek(max(0,st.st_size-4096));last=f.read(4096);ent['sample_sha256']=hashlib.sha256(first+last).hexdigest();ent['read_bytes']=len(first)+len(last)\n r.append(ent)\nout={'objects':r,'count':len(r),'purpose':'Q12/Q13 provenance declaration and machine-readability check; no secret values emitted'}\nopen(os.environ['OUT']+'/q12-q13-coverage-provenance.json','w').write(json.dumps(out,indent=2))\nprint('checked',len(r),'objects')\nPY"
