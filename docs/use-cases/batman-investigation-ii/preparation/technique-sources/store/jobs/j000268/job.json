    "command": "python3 - <<'PY'\nimport os,mmap,json,re\npaths=[\n'store/imports/j000141/out/20261002100001411-chunk_needles-ifyo.out.log',\n'store/jobs/j000001/out/wallet-ascii.txt','store/jobs/j000001/out/wallet-utf16.txt',\n'store/jobs/j000006/out/communication_hits.jsonl',\n'store/jobs/j000008/out/archive-ascii.txt','store/jobs/j000008/out/archive-utf16.txt',\n'store/jobs/j000013/out/file.0xab0b100c07e0.0xab0b1141dd20.ImageSectionObject.nss3.dll.img',\n'store/jobs/j000018/out/notepad-ascii.txt','store/jobs/j000018/out/pid.5372.dmp',\n'store/jobs/j000034/stdout.log','store/jobs/j000034/out/tool-output/ioc_scan-62747ce3f7081774.jsonl',\n'store/jobs/j000049/out/proc-ascii-hits.txt','store/jobs/j000049/out/proc-ascii.txt','store/jobs/j000049/out/proc/pid.3768.dmp',\n'store/jobs/j000053/out/file.0xab0b100da460.0xab0b152b95a0.ImageSectionObject.Exodus.exe.img',\n'store/jobs/j000079/out/7zg-ascii.txt','store/jobs/j000079/out/pid.1576.dmp',\n'store/jobs/j000092/out/7zfm-ascii.txt','store/jobs/j000092/out/pid.6628.dmp',\n'store/jobs/j000241/out/create-table-ranked.json']\nneed=[b'private_key',b'client_email',b'infobreakage_dbkey',b'name_client']\nout=[]\nfor p in paths:\n r={'path':p,'size':os.path.getsize(p),'hits':[]}\n with open(p,'rb') as f:\n  m=mmap.mmap(f.fileno(),0,access=mmap.ACCESS_READ)\n  for n in need:\n   for enc,q in [('ascii',n),('utf16le',b''.join(bytes((c,0)) for c in n))]:\n    pos=0\n    while True:\n     i=m.find(q,pos)\n     if i<0:break\n     a=max(0,i-240);z=min(len(m),i+len(q)+480);c=m[a:z]\n     # bounded printable rendering; preserve offsets, no long values\n     asc=' | '.join(x.decode('latin1','replace') for x in re.findall(rb'[\\x20-\\x7e]{5,}',c))\n     u16=' | '.join(x.decode('utf-16le','replace') for x in re.findall(rb'(?:[\\x20-\\x7e]\\x00){5,}',c))\n     r['hits'].append({'needle':n.decode(),'encoding':enc,'offset':i,'context':(asc+' | '+u16)[:1500]})\n     pos=i+len(q)\n  m.close()\n out.append(r)\njson.dump({'objects':out,'total_hits':sum(len(x['hits']) for x in out)},open(os.environ['OUT']+'/coverage-sweep-hit-contexts.json','w'),indent=2)\nprint('objects',len(out),'hits',sum(len(x['hits']) for x in out))\nfor x in out: print(len(x['hits']),x['path'])\nPY"
