len(seed),'scrypt':{'N':N,'r':r,'p':p},'cryptography_version':cryptography.__version__,'checksum_valid':True,'key_envelope_authenticated':False,'payload_authenticated':False}\ntry:\n blobkey=AESGCM(wrapping).decrypt(s[332:344],s[360:392]+s[344:360],None);summary['key_envelope_authenticated']=True\n plain=AESGCM(blobkey).decrypt(s[392:404],s[516:]+s[404:420],None);summary['payload_authenticated']=True;summary['payload_bytes']=len(plain)\n (out/'storage-authenticated-payload.bin').write_bytes(plain)\nexcept InvalidTag:summary['result']='Authentication failed for this one source-defined derivation/envelope interpretation; no storage-content absence inferred.'\n(out/'storage-authentication-summary.json').write_text(json.dumps(summary,indent=2));print(json.dumps(summary))\nPY",
