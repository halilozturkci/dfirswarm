    "host": "requires/host.json",
    "python": "requires/python.txt"
  },
  "secrets": [],
  "method_only": [
    {
      "path": "skills/accounts/users.md",
      "why": "a method leaf on configured identities and privileges; it reads files the examiner opens and names no tool or program (the session and history tools are in accounts/sessions-histories)"
    },
    {
      "path": "skills/persistence/quieter-routes.md",
      "why": "a method leaf for routes read as plain files (startup files, PAM, preload, SUID files, modules); it names no tool or program"
    },
    {
      "path": "skills/timeline/linux-normalise.md",
      "why": "a method leaf on normalising and correlating timestamps; it names only the base pack's timestamp_decode"
    },
    {
      "path": "skills/linux/router.md",
      "why": "the pack's router: it names the other notes by the question each answers and holds no rule, tool or program of its own"
    }
  ],
