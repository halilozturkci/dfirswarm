{
  "binaries": [
    {
      "name": "ileapp",
      "package": "iLEAPP",
      "optional": false,
      "why": "Several hundred iOS artefact parsers over a file-system extraction or a backup, with a report per artefact.",
      "install": {
        "brew": "https://github.com/abrignoni/iLEAPP (not on PyPI; run ileapp.py from a checkout)",
        "apt": "pinned source 2026.4.2 (install.source)",
        "source": {
          "version": "2026.4.2",
          "url": "https://github.com/abrignoni/iLEAPP/archive/refs/tags/v2026.4.2.tar.gz",
          "sha256": "932c5dc29a0e800f2a2397979a5e2e17ff49b7cb97fc9f04e8fff7700cd25d9c",
          "entry": "ileapp.py",
          "run": "python",
          "pip": [
            "-r",
            "requirements.txt"
          ],
          "skip": [
            "admin/test"
          ]
        }
      },
      "licence": "MIT",
      "redistributable": false
    },
    {
      "name": "aleapp",
      "package": "ALEAPP",
      "optional": false,
      "why": "The same for Android: app data, accounts, usage, and the protobuf-heavy newer artefacts.",
      "install": {
        "brew": "https://github.com/abrignoni/ALEAPP (not on PyPI; run aleapp.py from a checkout)",
        "apt": "pinned source 2026.4.1 (install.source)",
        "source": {
          "version": "2026.4.1",
          "url": "https://github.com/abrignoni/ALEAPP/archive/refs/tags/v2026.4.1.tar.gz",
          "sha256": "de60e539dfa89648a1d40971a357596103aec10d77b6184123aaf0afca549317",
          "entry": "aleapp.py",
          "run": "python",
          "pip": [
            "-r",
            "requirements.txt"
          ],
          "skip": [
            "admin/test"
          ],
          "build_deps": [
            "git",
            "pkg-config",
            "libsqlcipher-dev"
          ],
          "apt_deps": [
            "libsqlcipher0"
          ]
        }
      },
      "licence": "MIT",
      "redistributable": false
    },
    {
      "name": "idevicebackup2",
      "package": "libimobiledevice",
      "optional": true,
      "why": "Read and convert an iTunes or Finder backup, including one that is encrypted where the password is known.",
      "install": {
        "brew": "brew install libimobiledevice",
        "apt": "apt-get install -y libimobiledevice-utils"
      },
      "licence": "LGPL-2.1-or-later",
      "redistributable": false
    },
    {
      "name": "mac_apt.py",
      "package": "mac_apt",
      "optional": true,
      "why": "ios_apt, inside mac_apt, reads a full file-system iOS extraction with the same plugin model as the macOS side.",
      "install": {
        "brew": "https://github.com/ydkhatri/mac_apt",
        "apt": "pinned source 1.33.2 (install.source), amd64 only: its statx helper knows no aarch64 syscall number, so it stops at import on Linux arm64",
        "source": {
          "version": "1.33.2",
          "url": "https://github.com/ydkhatri/mac_apt/archive/refs/tags/v1.33.2.tar.gz",
          "sha256": "a2fff756df22236c03ab427424f565987749b711dece2c490184265c5a620be1",
          "entry": "mac_apt.py",
          "run": "python",
          "pip": [
            "-r",
            "requirements.txt"
          ],
          "arches": [
            "amd64"
          ],
          "env": {
            "ac_cv_header_libbfio_h": "no"
          }
        }
      },
      "licence": "MIT",
      "redistributable": false
    },
    {
      "name": "heif-convert",
      "package": "libheif-examples",
      "optional": true,
      "why": "An iPhone's HEIC photo converted to JPEG or PNG, to look at it or read it with the other tools; pillow-heif opens one in a script.",
      "install": {
        "brew": "brew install libheif",
        "apt": "apt-get install -y libheif-examples"
      },
      "licence": "LGPL-3.0-or-later",
      "redistributable": false
    }
  ]
}
