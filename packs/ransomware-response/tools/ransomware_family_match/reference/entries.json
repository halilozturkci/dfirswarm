  "entries": [
    {
      "id": "akira",
      "name": "Akira",
      "reviewed_on": "2026-11-04",
      "fresh_until": "2027-05-03",
      "evidence_strength": "strong",
      "evidence_basis": "the lowest evidence strength of its variants; a variant's strength is that of its strongest feature that is neither generic nor shape-only",
      "variants": [
        {
          "id": "akira-original",
          "label": "Akira, the original naming",
          "valid_for": "Sophos describes the naming in an undated report; Talos reports samples seen in early September 2024 returning to it, and says it matches versions before August 2023.",
          "evidence_strength": "strong",
          "features": [
            {
              "kind": "extension",
              "match": "exact",
              "value": ".akira",
              "strength": "strong",
              "generic": false,
              "sources": [
                "S01",
                "S02",
                "S03"
              ]
            },
            {
              "kind": "note_name",
              "match": "exact",
              "value": "akira_readme.txt",
              "strength": "strong",
              "generic": false,
              "sources": [
                "S01",
                "S02",
                "S03"
              ]
            }
          ],
          "context": [
            {
              "text": "Sophos and Unit 42 report that the Windows build tries to delete Volume Shadow Copies.",
              "sources": [
                "S01",
                "S02"
              ]
            }
          ]
        },
        {
          "id": "akira-v2-akiranew",
          "label": "Akira_v2, the build reported for Linux and ESXi",
          "valid_for": "Reported in 2024 (Talos 2024-10-21, Unit 42 2024-12-02).",
          "evidence_strength": "strong",
          "features": [
            {
              "kind": "extension",
              "match": "exact",
              "value": ".akiranew",
              "strength": "strong",
              "generic": false,
              "sources": [
                "S02",
                "S03"
              ]
            },
            {
              "kind": "note_name",
              "match": "exact",
              "value": "akiranew.txt",
              "strength": "strong",
              "generic": false,
              "sources": [
                "S02",
                "S03"
              ]
            }
          ],
          "context": [
            {
              "text": "Unit 42 assesses that the Linux and ESXi samples it describes, of which Akira_v2 is a later variant, were first designed to run on ESXi systems.",
              "sources": [
                "S02"
              ]
            },
            {
              "text": "Talos names a Rust build of Akira_v2 for Linux and ESXi.",
              "sources": [
                "S03"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "lockbit",
      "name": "LockBit",
      "reviewed_on": "2026-11-04",
      "fresh_until": "2027-05-03",
      "evidence_strength": "weak",
      "evidence_basis": "the lowest evidence strength of its variants; a variant's strength is that of its strongest feature that is neither generic nor shape-only",
      "variants": [
        {
          "id": "lockbit-lockbit-extension",
          "label": "LockBit samples reported with the .lockbit extension",
          "valid_for": "A Trend Micro entry dated 2020-05-21 and a Microsoft entry updated 2024-07-15 report it; neither ties the extension to a numbered version.",
          "evidence_strength": "strong",
          "features": [
            {
              "kind": "extension",
              "match": "exact",
              "value": ".lockbit",
              "strength": "strong",
              "generic": false,
              "sources": [
                "S05",
                "S06"
              ]
            },
            {
              "kind": "note_name",
              "match": "exact",
              "value": "restore-my-files.txt",
              "strength": "strong",
              "generic": false,
              "sources": [
                "S04",
                "S05",
                "S06"
              ]
            }
          ],
          "context": [
            {
              "text": "Trend Micro reports that the 2020 sample deletes shadow copies and the backup catalogue with built-in Windows commands.",
              "sources": [
                "S06"
              ]
            }
          ]
        },
        {
          "id": "lockbit-three",
          "label": "LockBit 3.0, as one vendor names it",
          "valid_for": "SentinelOne, first published 2022-11-30 and updated 2025-09-17; no other retrieved page names this extension, so it is a single-source lead.",
          "evidence_strength": "weak",
          "features": [
            {
              "kind": "extension",
              "match": "exact",
              "value": ".lockbit3",
              "strength": "weak",
              "generic": false,
              "sources": [
                "S04"
              ]
            },
            {
              "kind": "note_name",
              "match": "exact",
              "value": "restore-my-files.txt",
              "strength": "weak",
              "generic": false,
              "sources": [
                "S04"
              ]
            }
          ],
          "context": [
            {
              "text": "This variant rests on one page. The curator did not retrieve other vendors' reports, so a LockBit build whose extension or note name differs from these is not excluded by this entry, and a match here is a lead only.",
              "sources": [
                "S04"
              ]
            },
            {
              "text": "SentinelOne reports the note name above as the one dropped by LockBit 3.0.",
              "sources": [
                "S04"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "blackcat",
      "name": "BlackCat (ALPHV)",
      "reviewed_on": "2026-11-04",
      "fresh_until": "2027-05-03",
      "evidence_strength": "moderate",
      "evidence_basis": "the lowest evidence strength of its variants; a variant's strength is that of its strongest feature that is neither generic nor shape-only",
      "variants": [
        {
          "id": "blackcat-seven-character",
          "label": "BlackCat with a victim-specific seven-character extension",
          "valid_for": "Varonis (undated page, latest date late January 2022) describes it; Microsoft's 2022-06-13 post describes the payload.",
          "evidence_strength": "moderate",
          "features": [
            {
              "kind": "extension",
              "match": "regex",
              "pattern": "\\.[a-z0-9]{7}",
              "strength": "weak",
              "generic": false,
              "sources": [
                "S07"
              ],
              "shape_only": true
            },
            {
              "kind": "note_name",
              "match": "regex",
              "pattern": "recover-([a-z0-9]{7})-files\\.txt",
              "strength": "moderate",
              "generic": false,
              "sources": [
                "S07"
              ],
              "captures": "extension"
            }
          ],
          "context": [
            {
              "text": "The same seven characters name the extension and the note, so a note whose embedded text differs from the extension seen is a contradiction.",
              "sources": [
                "S07"
              ]
            },
            {
              "text": "Microsoft reports that the payload needs an --access-token argument on its command line to encrypt.",
              "sources": [
                "S08"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "black-basta",
      "name": "Black Basta",
      "reviewed_on": "2026-11-04",
      "fresh_until": "2027-05-03",
      "evidence_strength": "strong",
      "evidence_basis": "the lowest evidence strength of its variants; a variant's strength is that of its strongest feature that is neither generic nor shape-only",
      "variants": [
        {
          "id": "black-basta-basta-extension",
          "label": "Black Basta with the .basta extension",
          "valid_for": "Unit 42 (2022-08-25) analysed a sample; IBM X-Force (undated) says the group first appeared in April 2022 and gives a sample compile time in April 2022.",
          "evidence_strength": "strong",
          "features": [
            {
              "kind": "extension",
              "match": "exact",
              "value": ".basta",
              "strength": "strong",
              "generic": false,
              "sources": [
                "S09",
                "S10"
              ]
            },
            {
              "kind": "note_name",
              "match": "exact",
              "value": "readme.txt",
              "strength": "weak",
              "generic": true,
              "sources": [
                "S09",
                "S10"
              ]
            }
          ],
          "context": [
            {
              "text": "Unit 42 reports that the sample deletes Volume Shadow Copies with vssadmin.",
              "sources": [
                "S09"
              ]
            },
            {
              "text": "IBM X-Force and Unit 42 report that the sample sets a desktop wallpaper from a JPG in the temporary folder.",
              "sources": [
                "S09",
                "S10"
              ]
            }
          ]
        }
      ]
    },
    {
