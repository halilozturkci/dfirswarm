      "variants": [
        {
          "id": "rhysida-2023",
          "label": "Rhysida, as reported from 2023",
          "valid_for": "SentinelOne (first published 2023-05-23) and Trend Micro (2023-08-09).",
          "evidence_strength": "strong",
          "features": [
            {
              "kind": "extension",
              "match": "exact",
