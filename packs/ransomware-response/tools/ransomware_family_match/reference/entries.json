              ]
            }
          ]
        }
      ]
    },
    {
      "id": "phobos",
      "name": "Phobos",
      "reviewed_on": "2026-11-04",
      "fresh_until": "2027-05-03",
      "evidence_strength": "moderate",
      "evidence_basis": "the lowest evidence strength of its variants; a variant's strength is that of its strongest feature that is neither generic nor shape-only",
      "variants": [
        {
          "id": "phobos-core",
          "label": "Phobos with the id, mail address and .phobos suffix",
          "valid_for": "PCrisk (updated 2024-11-19) names the .phobos extension and the two note files; an analyst page (updated 2020-03-03) gives the rename as a pattern with placeholders and lists the shadow-copy commands it saw.",
          "evidence_strength": "moderate",
          "features": [
            {
              "kind": "extension",
              "match": "exact",
              "value": ".phobos",
              "strength": "moderate",
              "generic": false,
              "sources": [
                "S13"
              ]
            },
            {
              "kind": "extension",
              "match": "regex",
              "pattern": "\\.id\\[[^\\]]{1,64}\\]\\.\\[[^\\]]{1,128}\\]\\.[a-z0-9]{1,16}",
              "strength": "moderate",
              "generic": false,
              "sources": [
                "S14"
              ]
            },
            {
              "kind": "note_name",
              "match": "exact",
              "value": "info.hta",
              "strength": "moderate",
              "generic": false,
              "sources": [
                "S13"
              ]
            },
            {
              "kind": "note_name",
              "match": "exact",
              "value": "info.txt",
              "strength": "weak",
              "generic": true,
              "sources": [
                "S13"
              ]
            },
            {
              "kind": "note_text",
              "match": "yara",
              "rule": "rm_phobos_note_phrase_1",
              "strength": "moderate",
              "generic": false,
              "sources": [
                "S13"
              ],
              "rule_version": 1
            }
          ],
          "context": [
            {
              "text": "The analyst page lists vssadmin and wmic shadow-copy deletion commands for the sample it analysed.",
              "sources": [
                "S14"
              ]
            },
            {
              "text": "PCrisk says other variants use other extensions, such as .barak, .zax, .banjo and .BANKS; this entry does not match them.",
              "sources": [
                "S13"
              ]
            }
          ]
        },
        {
          "id": "phobos-8base",
          "label": "Phobos sample reported with the .8base extension",
          "valid_for": "The Hacker News, 2025-02-11, reports a Phobos sample with this extension.",
          "evidence_strength": "moderate",
          "features": [
            {
              "kind": "extension",
              "match": "exact",
              "value": ".8base",
              "strength": "moderate",
              "generic": false,
              "sources": [
                "S15"
              ]
            }
          ],
          "context": [
            {
              "text": "The page names no ransom note for it.",
              "sources": [
                "S15"
              ]
            }
          ]
        }
      ]
    },
