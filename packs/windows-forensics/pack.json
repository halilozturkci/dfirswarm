    "host": "requires/host.json",
    "python": "requires/python.txt"
  },
  "secrets": [],
  "unreferenced_ok": [
    {
      "name": "pffexport",
      "why": "declared for mailbox containers (PST/OST) met in a Windows examination; no skill of this pack covers mail, and the skill that would name it is planned for a later change to this pack"
    },
    {
      "name": "impacket",
      "why": "declared before this review for credential-store work; no skill may name it while the owner has not decided whether the pack keeps it (credential tooling is out of scope of this change, and the entry is left exactly as it was)"
    },
    {
      "name": "dpapick3",
      "why": "declared before this review for credential-store work; no skill may name it while the owner has not decided whether the pack keeps it (credential tooling is out of scope of this change, and the entry is left exactly as it was)"
    }
  ],
  "method_only": [
    {
      "path": "skills/execution/overview.md",
      "why": "a method leaf that weighs the execution sources against each other; the readers are in the leaves it points to, and it names no tool or program"
    },
    {
      "path": "skills/windows/router.md",
      "why": "the pack's router: it names the other notes by the question each answers and holds no rule, tool or program of its own"
    }
  ],
