{
  "name": "evtx_filter",
  "description": "Parse a local EVTX; return EventID/TimeCreated/EventData for matching IDs or a time prefix",
  "params": {
    "path": {
      "type": "string",
      "description": "Local .evtx path",
      "required": true
    },
    "event_ids": {
      "type": "string",
      "description": "Comma-separated EventIDs (e.g. 7045,7040,4624)"
    },
    "time_prefix": {
      "type": "string",
      "description": "Keep events whose TimeCreated starts with this (e.g. 2022-11-15T21:)"
    },
    "contains": {
      "type": "string",
      "description": "Substring filter on XML/JSON (case-insensitive)"
    },
    "limit": {
      "type": "integer",
      "description": "Max events to return (default 200)"
    }
  },
  "runtime": "python3",
  "entry": "run.py",
  "timeout_seconds": 60,
  "example": "{\"path\": \"work/sd1d101/evtx/System.evtx\", \"event_ids\": \"7045,7040\", \"time_prefix\": \"2022-11-15\"}",
