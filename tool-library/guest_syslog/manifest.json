{
  "name": "guest_syslog",
  "description": "Extract unique syslog-like lines from a binary (Kali/rsyslog) matching a month-day prefix; drop kernel lines.",
  "params": {
    "path": {
      "type": "string",
      "description": "Binary to scan",
      "required": true
    },
    "prefix": {
      "type": "string",
      "description": "Month-day prefix like 'Apr  6'"
    },
    "limit": {
      "type": "integer",
      "description": "Max unique lines"
    },
    "skip_kernel": {
      "type": "boolean",
      "description": "Drop kernel: lines"
    },
    "hour_re": {
      "type": "string",
      "description": "Optional regex on the line (e.g. 0[89]:)"
    }
  },
  "runtime": "python3",
  "entry": "run.py",
  "timeout_seconds": 30,
